{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/logan0817/MultiUrlManager/blob/main/docs/schemas/portable-configuration-v1.schema.json",
  "title": "MultiUrlManager 可移植配置 v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "environments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultEnvironment": {
      "type": "string",
      "minLength": 1,
      "description": "必须存在于 environments；导入时不会切换接收方当前环境"
    },
    "businessNames": {
      "type": "object",
      "description": "兼容配置 v1 的可选映射；导入不采用此映射，展示名由接收方宿主控制",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "requiredKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "configKey",
                "url"
              ],
              "properties": {
                "configKey": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "select": {
                  "type": "boolean"
                },
                "remark": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "time": {
                  "type": "integer"
                }
              }
            },
            "maxItems": 1000
          }
        }
      },
      "maxItems": 32
    }
  },
  "description": "导入上限 256 KiB UTF-8；业务键须在接收方已声明；语义校验由核心执行。",
  "not": {
    "anyOf": [
      {
        "required": [
          "revision"
        ]
      },
      {
        "required": [
          "environmentId"
        ]
      },
      {
        "required": [
          "defaults"
        ]
      }
    ]
  }
}
