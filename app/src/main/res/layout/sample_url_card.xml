<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/sample_card">
    <TextView
        android:id="@+id/tvBusinessKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sample_badge"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvBusinessUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/app_text"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />
    <TextView
        android:id="@+id/tvBusinessRemark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/app_secondary"
        android:textSize="13sp" />
</LinearLayout>
