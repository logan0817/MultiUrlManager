{
  "schemaVersion": 1,
  "defaultEnvironment": "production",
  "environments": [
    {
      "id": "production",
      "name": "Production",
      "requiredKeys": [
        "order",
        "login"
      ],
      "urls": [
        {
          "configKey": "order",
          "url": "https://order.example.com/",
          "select": true,
          "remark": "Production order service"
        },
        {
          "configKey": "order",
          "url": "https://order-backup.example.com/",
          "select": false,
          "remark": "Production order backup"
        },
        {
          "configKey": "login",
          "url": "https://login.example.com/",
          "select": true,
          "remark": "Production sign-in service"
        }
      ]
    }
  ]
}
